import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] nums = new int[n];

        for (int i = 0; i < n; i++)
            nums[i] = sc.nextInt();

        int val = sc.nextInt();

        for (int x : nums) {
            if (x != val)
                System.out.print(x + " ");
        }

        sc.close();
    }
}
