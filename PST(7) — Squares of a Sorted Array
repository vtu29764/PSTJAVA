import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        for (int i = 0; i < n; i++)
            arr[i] = sc.nextInt();

        int[] result = new int[n];

        for (int i = 0; i < n; i++)
            result[i] = arr[i] * arr[i];

        Arrays.sort(result);

        for (int x : result)
            System.out.print(x + " ");

        sc.close();
    }
}
